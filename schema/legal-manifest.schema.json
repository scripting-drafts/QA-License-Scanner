{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/scripting-drafts/QA-License-Scanner/schema/legal-manifest.schema.json",
  "title": "QA Legal Manifest",
  "description": "Shared own-product license and legal compliance register for QA projects.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "product",
    "spdx",
    "copyright",
    "source",
    "lastReviewed",
    "reviewedVersion",
    "components",
    "documents",
    "reviews"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "product": {
      "type": "string",
      "minLength": 1,
      "maxLength": 80
    },
    "spdx": {
      "$ref": "#/$defs/licenseExpression"
    },
    "copyright": {
      "type": "string",
      "minLength": 1,
      "maxLength": 240
    },
    "source": {
      "$ref": "#/$defs/httpsUrl"
    },
    "homepage": {
      "$ref": "#/$defs/httpsUrl"
    },
    "lastReviewed": {
      "$ref": "#/$defs/date"
    },
    "reviewedVersion": {
      "type": "string",
      "minLength": 1,
      "maxLength": 80
    },
    "reviewedComponents": {
      "type": "object",
      "additionalProperties": {
        "type": "string",
        "minLength": 1,
        "maxLength": 80
      }
    },
    "components": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "name", "license", "scope"],
        "properties": {
          "id": {
            "$ref": "#/$defs/id"
          },
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 120
          },
          "version": {
            "type": "string",
            "minLength": 1,
            "maxLength": 80
          },
          "versionFrom": {
            "type": "string",
            "minLength": 1,
            "maxLength": 80
          },
          "license": {
            "$ref": "#/$defs/licenseExpression"
          },
          "scope": {
            "enum": [
              "project",
              "shipped",
              "dependency",
              "build",
              "runtime",
              "asset",
              "system",
              "companion"
            ]
          },
          "notice": {
            "$ref": "#/$defs/relativePath"
          },
          "url": {
            "$ref": "#/$defs/httpsUrl"
          }
        }
      }
    },
    "documents": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "label", "path", "kind"],
        "properties": {
          "id": {
            "$ref": "#/$defs/id"
          },
          "label": {
            "type": "string",
            "minLength": 1,
            "maxLength": 120
          },
          "path": {
            "$ref": "#/$defs/relativePath"
          },
          "kind": {
            "enum": ["text", "html", "external"]
          },
          "maxBytes": {
            "type": "integer",
            "minimum": 1,
            "maximum": 10485760
          }
        }
      }
    },
    "reviews": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "category", "status", "date", "note"],
        "properties": {
          "id": {
            "$ref": "#/$defs/id"
          },
          "category": {
            "enum": [
              "licensing",
              "distribution",
              "privacy",
              "export",
              "trademark",
              "contributions",
              "accessibility"
            ]
          },
          "status": {
            "enum": ["reviewed", "pending", "not-applicable"]
          },
          "date": {
            "$ref": "#/$defs/date"
          },
          "note": {
            "type": "string",
            "maxLength": 500
          }
        }
      }
    }
  },
  "$defs": {
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9._-]*$",
      "maxLength": 64
    },
    "date": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
    },
    "httpsUrl": {
      "type": "string",
      "pattern": "^https://[^\\s]+$",
      "maxLength": 500
    },
    "licenseExpression": {
      "type": "string",
      "pattern": "^[A-Za-z0-9.+-]+(?: (?:AND|OR|WITH) [A-Za-z0-9.+-]+)*$",
      "maxLength": 240
    },
    "relativePath": {
      "type": "string",
      "minLength": 1,
      "maxLength": 300,
      "pattern": "^[A-Za-z0-9._@+/-]+$",
      "allOf": [
        {
          "not": {
            "pattern": "^/"
          }
        },
        {
          "not": {
            "pattern": "(^|/)\\.\\.(/|$)"
          }
        }
      ]
    }
  }
}
